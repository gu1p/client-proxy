# client-proxy defaults loaded from the wrapper directory.
# Real environment variables always take precedence.

# Where the external SSD is mounted.
SMART_SSD_MOUNT=/Volumes/SSD

# Root directory used for uv/npm/pnpm/cargo caches.
SMART_SSD_BASE=/Volumes/SSD/dev-caches

# Set to 1 to store uv virtual environments off-repo.
SMART_UV_MOVE_VENV=0

# Optional pnpm import method (for example: hardlink, copy, clone).
# Leave empty to use pnpm defaults.
SMART_PNPM_IMPORT_METHOD=

# Subdirectory (under SMART_SSD_BASE) used for Cargo target outputs.
SMART_CARGO_SUBDIR=cargo-targets

# Set to 1 for wrapper debug logs.
SMART_SSD_DEBUG=0
